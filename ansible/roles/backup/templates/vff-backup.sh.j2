#!/usr/bin/env bash
set -euo pipefail
JOB="${1:-}"
[[ "$JOB" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || { echo "Usage: $(basename "$0") <job-name>"; exit 2; }

# metrics toggle injected by template
METRICS_ENABLED={{ (backup_enable_metrics | bool) | ternary("true","false") }}
TEXTDIRS=({% if backup_enable_metrics | bool %}{% for d in backup_node_exporter_textfile_dirs %}"{{ d }}"{% if not loop.last %} {% endif %}{% endfor %}{% endif %})
METRIC_FILE="backup_metrics.prom"

start_ts=$(date +%s); status=0; size=0

write_metrics() {
  [[ "$METRICS_ENABLED" != "true" ]] && return 0
  local now metric_size d f tmp failed=0
  now=$(date +%s) || return 1
  metric_size="${size:-0}"
  [[ "$metric_size" =~ ^[0-9]+$ ]] || metric_size=0
  for d in "${TEXTDIRS[@]}"; do
    f="$d/$METRIC_FILE"
    if ! tmp=$(mktemp -- "$d/.$METRIC_FILE.XXXXXX"); then
      failed=1
      continue
    fi
    if ! {
      printf 'backup_last_run_timestamp_seconds{backup_job="%s"} %s\n' "$JOB" "$now" &&
      printf 'backup_last_duration_seconds{backup_job="%s"} %s\n' "$JOB" "$((now-start_ts))" &&
      printf 'backup_last_status{backup_job="%s"} %s\n' "$JOB" "$status" &&
      { if [[ "$metric_size" =~ [1-9] ]]; then
          printf 'backup_last_size_bytes{backup_job="%s"} %s\n' "$JOB" "$metric_size"
        fi; }
    } > "$tmp" || ! chmod 0644 "$tmp" || ! mv -fT -- "$tmp" "$f"; then
      rm -f -- "$tmp"
      failed=1
    fi
  done
  return "$failed"
}

# Единственная запись метрик — по фактическому коду выхода.
# ERR trap раньше выставлял status=1, а EXIT безусловно возвращал 0.
on_exit() {
  original_rc=$?
  trap - EXIT
  cleanup_failed=0
  # Одна попытка unpause на каждый контейнер, который этот run поставил на pause.
  # Ошибка одного unpause не прерывает остальные и не превращает failed job в success.
  if [[ "${paused_count:-0}" -gt 0 ]]; then
    for c in "${paused_containers[@]}"; do
      if ! docker unpause "$c"; then
        echo "[ERROR] failed to unpause container '$c'" >&2
        cleanup_failed=1
      fi
    done
    paused_count=0
  fi
  if [[ -n "${prepared_dir:-}" ]]; then
    if ! rm -rf -- "$prepared_dir"; then
      cleanup_failed=1
    fi
  fi
  rc=$original_rc
  if [[ "$rc" -eq 0 && "$cleanup_failed" -ne 0 ]]; then
    rc=1
  fi
  if [[ "$rc" -eq 0 ]]; then
    status=0
  else
    status=1
  fi
  if ! write_metrics; then
    echo "[ERROR] failed to publish backup metrics" >&2
    if [[ "${PREPARED_ENABLED:-false}" == "true" && "$rc" -eq 0 ]]; then
      rc=1
    fi
  fi
  exit "$rc"
}
paused_count=0
paused_containers=()

# embed jobs JSON (через heredoc, без read -d '')
JOBS_JSON=$(cat <<'EOF'
{% set _jobs = (backup_jobs if (backup_jobs is defined and (backup_jobs|length)>0)
                else ((backup_jobs_map|default({}))|dict2items|map(attribute='value')|list)) %}
{{ _jobs | to_nice_json }}
EOF
)

jq_job(){ echo "$JOBS_JSON" | jq -r --arg job "$JOB" ".[] | select(.name==\$job) | $1"; }

# ensure job exists
if ! echo "$JOBS_JSON" | jq -e --arg job "$JOB" '[.[] | select(.name==$job)] | length == 1' >/dev/null; then
  echo "[ERROR] job '$JOB' not found in JOBS_JSON" >&2
  exit 2
fi

PREPARED_ENABLED=$(jq_job 'has("prepared_snapshot")')
if [[ "$PREPARED_ENABLED" == "true" ]]; then
  METRIC_FILE="backup_job-$JOB.prom"
fi
trap on_exit EXIT

# IV-03/05: the reviewed role embeds the same trust checker used during
# Ansible preflight. No external adapter or shell env is loaded first.
PREPARED_KIND=$(jq_job 'if .prepared_snapshot == null or (.prepared_snapshot | has("kind") | not) then "generic" else .prepared_snapshot.kind end')
PREPARED_ROOT=$(jq_job '.prepared_snapshot.root // ""')
PREPARED_PROGRAM=$(jq_job '.prepared_snapshot.program // ""')
PREPARED_VERIFIER="{{ backup_prepared_verifier_path | default('/usr/local/libexec/vff-verify-prepared-snapshot') }}"
CHATWOOT_VERIFIER="{{ backup_chatwoot_verifier_path | default('/usr/local/libexec/vff-backup/chatwoot_snapshot_contract.py') }}"
if [[ "$JOB" =~ ^(chatwoot(-[A-Za-z0-9_-]+)?|vm205-prepared-drill)$ ]] &&
   [[ "$PREPARED_ENABLED" != true || "$PREPARED_KIND" != chatwoot ]]; then
  echo "[ERROR] Chatwoot job requires its semantic prepared verifier" >&2
  exit 1
fi
prepared_trust() {
  /usr/bin/python3 -I -c "$(cat <<'VFF_PREPARED_TRUST_PY'
{{ backup_prepared_trust_source }}
VFF_PREPARED_TRUST_PY
)" "$@"
}
prepared_paths=()
if [[ "$PREPARED_ENABLED" == true ]]; then
  case "$PREPARED_KIND" in
    generic) ;;
    chatwoot) PREPARED_VERIFIER="$CHATWOOT_VERIFIER" ;;
    *) echo "[ERROR] unsupported prepared snapshot kind" >&2; exit 1 ;;
  esac
  [[ "$(jq_job '(.prepared_snapshot.trusted_paths // []) | type == "array" and all(.[]; type == "string" and test("^/[A-Za-z0-9_./-]+$"))')" == true ]] || {
    echo "[ERROR] invalid prepared dependency inventory" >&2; exit 1;
  }
  mapfile -t prepared_paths < <(jq_job '(.prepared_snapshot.trusted_paths // [])[]')
  if [[ "$PREPARED_KIND" == chatwoot ]]; then
    [[ -n "${prepared_paths[*]}" ]] || { echo "[ERROR] Chatwoot execution dependencies required" >&2; exit 1; }
    prepared_paths+=("$(dirname -- "$CHATWOOT_VERIFIER")/verify_prepared_snapshot.py")
  fi
  prepared_trust "$0" "{{ backup_env_file }}" "$PREPARED_ROOT" "$PREPARED_PROGRAM" "$PREPARED_VERIFIER" "${prepared_paths[@]}" || exit 1
fi

# load env (не падаем, если файла нет / ошибка)
set -a
if [[ -f "{{ backup_env_file }}" ]]; then
  set +e
  # shellcheck disable=SC1091
  source "{{ backup_env_file }}"
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    echo "[ERROR] Failed to source {{ backup_env_file }} (rc=$rc)" >&2
    exit 1
  fi
else
  echo "[WARN] Env file {{ backup_env_file }} not found; continuing with current env" >&2
fi
set +a

PATHS=$(jq_job '(.paths // []) | @sh')
prepared_dir=""
DUMP_ENABLED=$(jq_job '.db_dump.enabled // false')
DUMP_DIR=$(jq_job '.db_dump.dump_dir // ""')
DUMP_CONTAINER=$(jq_job '.db_dump.container // ""')
DUMP_COMMAND=$(jq_job '.db_dump.command // ""')
DUMP_PAUSE_FIRST=$(jq_job '.db_dump.pause_before_dump // false')
COMPOSE_DIR=$(jq_job '.compose_dir // ""')
PAUSE_CONTAINERS=$(jq_job '.containers // [] | @sh')
EXCLUDES=$(jq_job '.exclude_paths // [] | @sh')

# соберём флаги --exclude
RESTIC_EXCLUDES=""
if [[ -n "$EXCLUDES" ]]; then
  eval "set -- $EXCLUDES"
  for e in "$@"; do
    # безопасно экранируем путь
    RESTIC_EXCLUDES+=" --exclude $(printf %q "$e")"
  done
fi

# cleanup old DB dumps in dump_dir (after a successful dump, before restic backup)
# keep N newest by count, or by days if count==0 and days>0
CLEAN_KEEP_COUNT={{ backup_dump_keep_count | default(7) | int }}
CLEAN_KEEP_DAYS={{ backup_dump_keep_days  | default(0) | int }}

{% raw %}
fail() {
  echo "[ERROR] $*" >&2
  exit 1
}

declare -A DUMP_BEFORE_PATHS=()

record_existing_dumps() {
  shopt -s nullglob
  local f
  for f in "$DUMP_DIR"/*.sql.gz; do
    DUMP_BEFORE_PATHS["$f"]=1
  done
  shopt -u nullglob
}

# Имя ещё не существует: команда создаёт файл, а не открывает старый pathname.
allocate_dump_out() {
  local stamp attempt candidate
  attempt=0
  while [[ "$attempt" -lt 100 ]]; do
    stamp=$(date +%F_%H%M%S_%N)
    candidate="$DUMP_DIR/${JOB}_${stamp}_$$_${RANDOM}.sql.gz"
    if [[ ! -e "$candidate" ]]; then
      DUMP_OUT=$candidate
      return 0
    fi
    attempt=$((attempt + 1))
  done
  return 1
}

# Удаляет только файлы, появившиеся в этом запуске. Ранее снятые дампы не трогает.
remove_new_dumps() {
  shopt -s nullglob
  local f
  for f in "$DUMP_DIR"/*.sql.gz; do
    if [[ -z "${DUMP_BEFORE_PATHS[$f]+x}" ]]; then
      rm -f -- "$f"
    fi
  done
  shopt -u nullglob
}

# An opt-in consistent ordering: pause the application writers before dumping
# and keep them paused through restic backup. Legacy jobs remain unchanged.
pause_job_containers() {
  [[ -n "$PAUSE_CONTAINERS" ]] || return 0
  eval "set -- $PAUSE_CONTAINERS"
  for c in "$@"; do
    if docker pause "$c"; then
      paused_containers+=("$c")
      paused_count=$((paused_count + 1))
    else
      fail "failed to pause container '$c'"
    fi
  done
}

[[ "$DUMP_PAUSE_FIRST" == "true" || "$DUMP_PAUSE_FIRST" == "false" ]] || fail "invalid db_dump.pause_before_dump"
if [[ "$DUMP_PAUSE_FIRST" == "true" ]]; then
  [[ "$DUMP_ENABLED" == "true" ]] || fail "pause_before_dump requires enabled db_dump"
  [[ -n "$PAUSE_CONTAINERS" ]] || fail "pause_before_dump requires writer containers"
  eval "set -- $PAUSE_CONTAINERS"
  for c in "$@"; do
    [[ "$c" != "$DUMP_CONTAINER" ]] || fail "cannot pause dump container '$c'"
  done
fi

# Opt-in, exclusive prepared-generation mode. The root-owned capture adapter
# must finish and resume its writers before sealing; the role never pauses
# or starts Docker services for this mode.
if [[ "$PREPARED_ENABLED" == "true" ]]; then
  case "$PREPARED_KIND" in
    generic) ;;
    chatwoot) PREPARED_VERIFIER="$CHATWOOT_VERIFIER" ;;
    *) fail "unsupported prepared snapshot kind" ;;
  esac
  [[ "$(jq_job 'has("db_dump") or has("compose_dir")')" == "false" && -z "$PAUSE_CONTAINERS" && -z "$PATHS" && -z "$EXCLUDES" ]] || fail "prepared snapshot cannot combine legacy settings"
  # Recheck the entire trusted chain immediately before root execution.
  prepared_trust "$PREPARED_ROOT" "$PREPARED_PROGRAM" "$PREPARED_VERIFIER" "${prepared_paths[@]}" || fail "unsafe prepared execution path"
  [[ -d "$PREPARED_ROOT" && "$(stat -c '%u:%a' "$PREPARED_ROOT")" == "$EUID:700" ]] || fail "unsafe staging root"
  for executable in "$PREPARED_PROGRAM" "$PREPARED_VERIFIER"; do
    [[ -f "$executable" && -x "$executable" && "$(stat -c '%u' "$executable")" == "$EUID" ]] || fail "unsafe prepared executable"
    mode=$(stat -c '%a' "$executable")
    (( (8#$mode & 022) == 0 )) || fail "writable prepared executable"
  done
  umask 077
  [[ ! -L "$PREPARED_ROOT/.backup.lock" ]] || fail "unsafe staging lock"
  exec 9>"$PREPARED_ROOT/.backup.lock"
  flock -n 9 || fail "prepared snapshot already running"
  shopt -s nullglob
  stale_generations=("$PREPARED_ROOT"/generation-*)
  shopt -u nullglob
  [[ ${#stale_generations[@]} -eq 0 ]] || fail "unreconciled prepared generation"
  prepared_dir=$(mktemp -d "$PREPARED_ROOT/generation-XXXXXXXX")
  "$PREPARED_PROGRAM" "$prepared_dir" || fail "prepared snapshot capture failed"
  # A renamed/misclassified job must not route a recognizable Chatwoot
  # capture through the generic integrity-only verifier.
  if [[ "$PREPARED_KIND" == generic ]] &&
     [[ -e "$prepared_dir/source/chatwoot.dump" || -e "$prepared_dir/chatwoot.dump" ]]; then
    fail "Chatwoot capture requires its semantic prepared verifier"
  fi
  "$PREPARED_VERIFIER" "$prepared_dir" || fail "prepared snapshot verification failed"
fi

# Обязательный дамп: без нового валидного файла restic не запускается.
if [[ "$DUMP_ENABLED" == "true" ]]; then
  [[ -n "$DUMP_DIR" ]] || fail "db_dump is enabled but dump_dir is empty"
  [[ -n "$DUMP_COMMAND" ]] || fail "db_dump is enabled but command is empty"
  mkdir -p "$DUMP_DIR"

  if [[ -n "$COMPOSE_DIR" && ! -d "$COMPOSE_DIR" ]]; then
    fail "compose directory '$COMPOSE_DIR' does not exist"
  fi

  if [[ -n "$DUMP_CONTAINER" ]]; then
    [[ -n "$COMPOSE_DIR" ]] || fail "db_dump container '$DUMP_CONTAINER' is set but compose_dir is empty"
    cd "$COMPOSE_DIR"
    if ! services=$(docker compose ps --services); then
      fail "failed to list compose services in '$COMPOSE_DIR'"
    fi
    if ! printf '%s\n' "$services" | grep -qx "$DUMP_CONTAINER"; then
      fail "compose service '$DUMP_CONTAINER' not found; db_dump is required"
    fi
  fi

  if [[ "$DUMP_PAUSE_FIRST" == "true" ]]; then
    pause_job_containers
  fi

  # noclobber: `>` в DUMP_COMMAND не может затереть уже существующий файл.
  allocate_dump_out || fail "could not allocate a unique dump path in '$DUMP_DIR'"
  quoted_out=$(printf '%q' "$DUMP_OUT")
  dump_shell="set -o pipefail; set -o noclobber; DUMP_OUT=$quoted_out; $DUMP_COMMAND"
  if [[ -n "$DUMP_CONTAINER" ]]; then
    dump_runner=(docker compose exec -T "$DUMP_CONTAINER" bash -lc "$dump_shell")
  else
    dump_runner=(bash -lc "$dump_shell")
  fi

  record_existing_dumps
  set +e
  "${dump_runner[@]}"
  dump_rc=$?
  set -e
  if [[ "$dump_rc" -ne 0 ]]; then
    remove_new_dumps
    fail "db dump command failed (rc=$dump_rc)"
  fi

  new_files=()
  shopt -s nullglob
  for f in "$DUMP_DIR"/*.sql.gz; do
    if [[ -z "${DUMP_BEFORE_PATHS[$f]+x}" ]]; then
      new_files+=("$f")
    fi
  done
  shopt -u nullglob

  if [[ ${#new_files[@]} -eq 0 ]]; then
    fail "db dump finished but no new *.sql.gz was created in '$DUMP_DIR'"
  fi

  for f in "${new_files[@]}"; do
    sz=$(stat -c '%s' "$f")
    if [[ "$sz" -eq 0 ]]; then
      echo "[ERROR] new db dump is empty: $f" >&2
      remove_new_dumps
      exit 1
    fi
    if ! gzip -t "$f"; then
      echo "[ERROR] gzip -t failed for new db dump: $f" >&2
      remove_new_dumps
      exit 1
    fi
  done
fi

if [[ -n "$DUMP_DIR" ]]; then
  if [[ $CLEAN_KEEP_COUNT -gt 0 ]]; then
    shopt -s nullglob
    # берём только *.sql.gz (наши дампы)
    mapfile -t _dumps < <(ls -1t "$DUMP_DIR"/*.sql.gz 2>/dev/null || true)
    if (( ${#_dumps[@]} > CLEAN_KEEP_COUNT )); then
      # удалить всё, что «хвост» после N последних
      to_delete=( "${_dumps[@]:CLEAN_KEEP_COUNT}" )
      rm -f -- "${to_delete[@]}" 2>/dev/null || true
    fi
    shopt -u nullglob
  elif [[ $CLEAN_KEEP_DAYS -gt 0 ]]; then
    find "$DUMP_DIR" -type f -name '*.sql.gz' -mtime +"$CLEAN_KEEP_DAYS" -delete 2>/dev/null || true
  fi
fi
{% endraw %}

# Legacy jobs pause after dumping. Unpause is handled by the EXIT trap.
if [[ "$DUMP_PAUSE_FIRST" != "true" ]]; then
  pause_job_containers
fi

# backup запускается только если обязательный dump выше не завершил job
set +e
if [[ "$PREPARED_ENABLED" == "true" ]]; then
  out=$(restic backup --one-file-system --json --host "$(hostname)" --tag "$JOB" "$prepared_dir")
else
  out=$(eval "restic backup --one-file-system --json --tag \"$JOB\" $RESTIC_EXCLUDES $(eval echo $PATHS)")
fi
backup_rc=$?
set -e
if [[ $backup_rc -ne 0 ]]; then
  echo "[ERROR] restic backup failed (rc=$backup_rc)" >&2
  exit 1
fi
size=$(echo "$out" | jq -r 'select(.message_type=="summary") | (.data_added // .total_bytes_processed // 0)')
if [[ "$PREPARED_ENABLED" == "true" ]]; then
  # A successful process exit alone is insufficient for a verified capture.
  snapshot_id=$(printf '%s\n' "$out" | jq -ser '[.[] | select(.message_type=="summary") | .snapshot_id] | if length == 1 and (.[0] | type=="string") then .[0] else error("missing snapshot ID") end') || fail "missing prepared snapshot receipt"
  [[ "$snapshot_id" =~ ^[0-9a-f]{8,64}$ ]] || fail "invalid prepared snapshot ID"
  printf '[INFO] verified prepared snapshot %s\n' "$snapshot_id"
fi

# retention — прежняя политика, только после успешного snapshot
set +e
forget_scope=()
if [[ "$PREPARED_ENABLED" == "true" ]]; then
  forget_scope=(--group-by host,tags --host "$(hostname)" --tag "$JOB")
fi
restic forget --json "${forget_scope[@]}" \
  --keep-last {{ backup_forget_policy.keep_last }} \
  --keep-daily {{ backup_forget_policy.keep_daily }} \
  --keep-weekly {{ backup_forget_policy.keep_weekly }} \
  --keep-monthly {{ backup_forget_policy.keep_monthly }} \
  --prune >/dev/null
forget_rc=$?
set -e
if [[ $forget_rc -ne 0 ]]; then
  echo "[ERROR] restic forget failed (rc=$forget_rc)" >&2
  exit 1
fi
